---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Hvala na upitu" noIndex={true}>
  <section class="thanks-page section">
    <div class="container thanks-inner">
      <div class="thanks-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
      <h1>Hvala na vašem upitu!</h1>
      <p>Vaša poruka je uspešno primljena. Kontaktiraćemo vas u roku od 24 časa.</p>
      <Button href="/" variant="outline">Nazad na početnu</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .thanks-inner {
    text-align: center;
    max-width: 28rem;
    margin: 0 auto;
  }

  .thanks-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    border: 1px solid var(--color-border-gold);
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  .thanks-inner h1 {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0 0 0.75rem;
  }

  .thanks-inner p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
    line-height: 1.7;
  }
</style>
