---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Kontakt"
  description="Kontaktirajte Despot nekretnine — pozovite, pišite ili nas pronađite na Instagramu."
>
  <section class="page-hero section-sm">
    <div class="container">
      <p class="section-eyebrow">Stupite u kontakt</p>
      <h1>Dostupni smo za vas</h1>
      <p class="page-hero-sub">
        Pozovite, pošaljite poruku ili nas pronađite na Instagramu. Odgovaramo brzo.
      </p>
    </div>
  </section>

  <!-- Glavni kontakt -->
  <section class="section contact-main-section">
    <div class="container">

      <!-- Istaknuti telefon -->
      <div class="phone-feature">
        <span class="phone-label">Pozovite nas direktno</span>
        <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="phone-number">
          {site.contact.phone}
        </a>
        <span class="phone-sub">Pon – Pet: 09:00 – 17:00 &nbsp;·&nbsp; Sub: 09:00 – 13:00</span>
      </div>

      <div class="divider-gold" aria-hidden="true"></div>

      <!-- Kanali -->
      <div class="channels-row">

        <a href={`mailto:${site.contact.email}`} class="channel">
          <span class="channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </span>
          <div>
            <p class="channel-label">E-mail</p>
            <p class="channel-value">{site.contact.email}</p>
          </div>
        </a>

        <div class="channel-divider" aria-hidden="true"></div>

        <a
          href="https://www.instagram.com/_prodaja_nekretnina_/"
          target="_blank"
          rel="noopener noreferrer"
          class="channel"
        >
          <span class="channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/>
            </svg>
          </span>
          <div>
            <p class="channel-label">Instagram</p>
            <p class="channel-value">@_prodaja_nekretnina_</p>
          </div>
        </a>

        <div class="channel-divider" aria-hidden="true"></div>

        <div class="channel">
          <span class="channel-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </span>
          <div>
            <p class="channel-label">Adresa</p>
            <p class="channel-value">{site.contact.address}</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Radno vreme -->
  <section class="hours-section section-sm">
    <div class="container hours-inner">
      <div class="hours-text">
        <p class="section-eyebrow">Radno vreme</p>
        <h2>Kada smo dostupni</h2>
        <p class="hours-note">
          Van radnog vremena možete nam pisati na Instagram ili e-mail — odgovaramo prvom prilikom.
        </p>
      </div>
      <div class="hours-table-wrap">
        <table class="hours-table">
          <tbody>
            <tr>
              <td>Ponedeljak</td>
              <td><span class="hours-open">09:00 – 17:00</span></td>
            </tr>
            <tr>
              <td>Utorak</td>
              <td><span class="hours-open">09:00 – 17:00</span></td>
            </tr>
            <tr>
              <td>Sreda</td>
              <td><span class="hours-open">09:00 – 17:00</span></td>
            </tr>
            <tr>
              <td>Četvrtak</td>
              <td><span class="hours-open">09:00 – 17:00</span></td>
            </tr>
            <tr>
              <td>Petak</td>
              <td><span class="hours-open">09:00 – 17:00</span></td>
            </tr>
            <tr>
              <td>Subota</td>
              <td><span class="hours-open">09:00 – 13:00</span></td>
            </tr>
            <tr>
              <td>Nedelja</td>
              <td><span class="hours-closed">Zatvoreno</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== PAGE HERO ===== */
  .page-hero {
    background-color: #000000;
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0.5rem 0 1rem;
  }

  .page-hero-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0;
    line-height: 1.7;
  }

  /* ===== GLAVNI KONTAKT ===== */
  .contact-main-section {
    background-color: var(--color-background);
  }

  /* Istaknuti telefon */
  .phone-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding-bottom: 3.5rem;
  }

  .phone-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .phone-number {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1;
    transition: color 0.2s;
  }

  .phone-number:hover {
    color: var(--color-primary);
  }

  .phone-sub {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }

  /* Zlatna linija */
  .divider-gold {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201,168,76,0.4), transparent);
    margin-bottom: 3.5rem;
  }

  /* Kanali */
  .channels-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
  }

  .channel {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0 3rem;
    text-decoration: none;
    flex: 1;
    min-width: 200px;
  }

  a.channel:hover .channel-value {
    color: var(--color-primary);
  }

  a.channel:hover .channel-icon {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .channel-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: border-color 0.2s, color 0.2s;
  }

  .channel-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.3rem;
  }

  .channel-value {
    font-size: 0.9375rem;
    color: var(--color-text);
    font-weight: 500;
    margin: 0;
    transition: color 0.2s;
  }

  .channel-divider {
    width: 1px;
    height: 3.5rem;
    background-color: var(--color-border);
    align-self: center;
    flex-shrink: 0;
  }

  /* ===== RADNO VREME ===== */
  .hours-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .hours-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .hours-text h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin: 0.5rem 0 1rem;
  }

  .hours-note {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .hours-table-wrap {
    border: 1px solid var(--color-border);
  }

  .hours-table {
    width: 100%;
    border-collapse: collapse;
  }

  .hours-table tr {
    border-bottom: 1px solid var(--color-border);
  }

  .hours-table tr:last-child {
    border-bottom: none;
  }

  .hours-table td {
    padding: 0.875rem 1.25rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .hours-table td:first-child {
    border-right: 1px solid var(--color-border);
  }

  .hours-table td:last-child {
    text-align: right;
  }

  .hours-open {
    font-weight: 600;
    color: var(--color-text);
  }

  .hours-closed {
    font-size: 0.8rem;
    color: var(--color-text-dim);
    letter-spacing: 0.05em;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .hours-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 700px) {
    .channels-row {
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
    }

    .channel {
      padding: 0;
    }

    .channel-divider {
      display: none;
    }
  }
</style>
