---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionTitle from '../components/sections/SectionTitle.astro';
import { site } from '../data/site';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-nekretnina.jpg';
---

<BaseLayout>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-glow"></div>
    </div>
    <div class="container hero-content">

      <!-- Leva kolona: tekst -->
      <div class="hero-left">
        <div class="hero-text">
          <p class="hero-eyebrow">
            <span class="eyebrow-line"></span>
            Više od običnog posredovanja
          </p>
          <h1 class="hero-title">
            Mi se bavimo<br />vašim stanom,<br />
            <span class="hero-title-gold">a vi se bavite vašim danom.</span>
          </h1>
          <p class="hero-subtitle">
            Despot nekretnine — prodaja, iznajmljivanje i kompletno upravljanje nekretninom. Vi donosite odluku, mi se brinemo o svemu ostalom.
          </p>
          <div class="hero-actions">
            <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="hero-phone-cta">
              <span class="hero-phone-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.82a19.79 19.79 0 01-3.07-8.63A2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                </svg>
              </span>
              {site.contact.phone}
            </a>
            <Button href="/usluge" variant="outline" size="lg">Naše usluge</Button>
          </div>
        </div>

        <!-- Brand priča -->
        <div class="hero-story">
          <div class="hero-story-stat">
            <span class="story-number">30+</span>
            <span class="story-label">Godina iskustva<br/>u timu</span>
          </div>
          <div class="hero-story-divider" aria-hidden="true"></div>
          <p class="hero-story-text">
            Nova agencija — ali ne i bez iskustva.<br/>
            Iza nas stoje decenije rada na tržištu nekretnina, uz mlad tim koji zna kako se radi danas.
          </p>
        </div>
      </div>

      <!-- Desna kolona: hero fotografija -->
      <div class="hero-right">
        <div class="hero-image-wrap">
          <Image
            src={heroImage}
            alt="Beograd — Despot nekretnine"
            class="hero-image"
            loading="eager"
          />
          <div class="hero-image-corner hero-image-corner--tl"></div>
          <div class="hero-image-corner hero-image-corner--br"></div>
        </div>
      </div>

    </div>
  </section>

  <!-- ===== USLUGE ===== -->
  <section class="section services-section">
    <div class="container">
      <SectionTitle
        eyebrow="Šta nudimo"
        title="Kompletna podrška na svakom koraku"
        subtitle="Od prvog razgovora do potpisa ugovora — tu smo za vas."
        align="center"
      />

      <div class="services-grid">
        {[
          {
            num: '01',
            title: 'PRODAJA',
            desc: 'Nekretninu može pokazati svako. Prodati je — to je veština. Pregovaramo u vaše ime i obezbeđujemo pravu cenu.',
            href: '/usluge#prodaja',
          },
          {
            num: '02',
            title: 'IZNAJMLJIVANJE',
            desc: 'Pravi zakupac, bez stresa. Proveravamo, ugovaramo i organizujemo primopredaju — sve umesto vas.',
            href: '/usluge#izdavanje',
          },
          {
            num: '03',
            title: 'UPRAVLJANJE IZDAVANJEM',
            desc: 'Živite daleko od vaše nekretnine? Vodimo ceo proces umesto vas. Vi samo proverite račun svakog prvog u mesecu.',
            href: '/usluge#upravljanje',
          },
        ].map((s) => (
          <div class="service-card">
            <span class="service-num">{s.num}</span>
            <div class="service-divider"></div>
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
            <a href={s.href} class="service-link" aria-label={`Saznajte više o usluzi ${s.title}`}>
              Saznajte više
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ZAŠTO MI ===== -->
  <section class="section why-section">
    <div class="container why-inner">

      <div class="why-text-col">
        <p class="section-eyebrow">Zašto mi</p>
        <h2 class="why-title">
          Staro znanje,
          <span class="text-gold">svež pristup.</span>
        </h2>

        <p class="why-body">
          Nismo samo još jedna agencija. Iza nas stoji 30 godina rada na tržištu nekretnina — iskustvo koje se ne može kupiti. Ispred nas su mladi profesionalci koji ne rade po staroj školi, nego po rezultatima.
        </p>

        <ul class="why-list">
          {[
            '30+ godina iskustva u timu — znamo kako tržište zaista funkcioniše',
            'Mlad tim sa svežim pogledom i direktnim pristupom',
            'Transparentnost — uvek znate šta se dešava i zašto',
            'Brz odgovor — dostupni smo kad vam zatreba',
          ].map((item) => (
            <li class="why-item">
              <span class="why-arrow" aria-hidden="true">›</span>
              {item}
            </li>
          ))}
        </ul>

        <Button href="/o-nama" variant="outline" size="md">O nama</Button>
      </div>

      <div class="why-visual-col" aria-hidden="true">
        <div class="why-box-outer">
          <div class="why-box-inner">
            <img src="/logo.jpg" alt="" width="120" height="120" style="border-radius: 50%; object-fit: contain;" />
            <p class="why-box-brand">ДЕСПОТ<br/>некретнине</p>
            <span class="why-box-line"></span>
            <p class="why-box-tagline">Više od običnog posredovanja</p>
          </div>
          <div class="stat-float stat-float--tl">
            <span class="stat-float-num">30+</span>
            <span class="stat-float-lbl">godina iskustva</span>
          </div>
          <div class="stat-float stat-float--br">
            <span class="stat-float-tag">Spoj mladosti</span>
            <span class="stat-float-lbl">i iskustva</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== KONTAKT KANALI ===== -->
  <section class="contact-channels">
    <div class="contact-channels-line" aria-hidden="true"></div>
    <div class="container">
      <div class="channels-header">
        <p class="section-eyebrow">Stupite u kontakt</p>
        <h2 class="channels-title">Dostupni smo za vas</h2>
      </div>
      <div class="channels-grid">
        <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="channel-card">
          <span class="channel-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.82a19.79 19.79 0 01-3.07-8.63A2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </span>
          <span class="channel-label">Pozovite nas</span>
          <span class="channel-value">{site.contact.phone}</span>
        </a>

        <a href={`mailto:${site.contact.email}`} class="channel-card">
          <span class="channel-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </span>
          <span class="channel-label">Pišite nam</span>
          <span class="channel-value">{site.contact.email}</span>
        </a>

        <a href="https://www.instagram.com/_prodaja_nekretnina_/" target="_blank" rel="noopener noreferrer" class="channel-card">
          <span class="channel-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/>
            </svg>
          </span>
          <span class="channel-label">Instagram</span>
          <span class="channel-value">@_prodaja_nekretnina_</span>
        </a>

        <div class="channel-card channel-card--address">
          <span class="channel-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </span>
          <span class="channel-label">Adresa</span>
          <span class="channel-value">{site.contact.address}</span>
        </div>
      </div>
    </div>
    <div class="contact-channels-line" aria-hidden="true"></div>
  </section>

</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: #000000;
  }

  .hero-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero-bg-glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60%;
    height: 80%;
    background: radial-gradient(ellipse, rgba(201,168,76,0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: stretch;
    padding-top: 5rem;
    padding-bottom: 5rem;
    width: 100%;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
  }

  .hero-text { max-width: 100%; }

  /* Desna kolona */
  .hero-right {
    display: flex;
  }

  .hero-image-wrap {
    position: relative;
    width: 100%;
    border: 1px solid var(--color-border-gold);
    overflow: hidden;
  }

  /* Hero slika */
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Zlatni ugaoni detalji */
  .hero-image-corner {
    position: absolute;
    width: 2rem;
    height: 2rem;
    pointer-events: none;
  }

  .hero-image-corner--tl {
    top: 0.75rem;
    left: 0.75rem;
    border-top: 1px solid var(--color-primary);
    border-left: 1px solid var(--color-primary);
    opacity: 0.5;
  }

  .hero-image-corner--br {
    bottom: 0.75rem;
    right: 0.75rem;
    border-bottom: 1px solid var(--color-primary);
    border-right: 1px solid var(--color-primary);
    opacity: 0.5;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  .eyebrow-line {
    display: block;
    width: 2.5rem;
    height: 1px;
    background-color: var(--color-primary);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
  }

  .hero-title-gold {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0 0 2.25rem;
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  /* Brand priča ispod heroa */
  .hero-story {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 2rem;
    border: 1px solid var(--color-border-gold);
    background: rgba(201,168,76,0.03);
    width: fit-content;
    max-width: 36rem;
  }

  .hero-story-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex-shrink: 0;
  }

  .story-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .story-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    line-height: 1.5;
  }

  .hero-story-divider {
    width: 1px;
    height: 3rem;
    background-color: var(--color-border);
    flex-shrink: 0;
  }

  .hero-story-text {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ===== USLUGE ===== */
  .services-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 3.5rem;
    border: 1px solid var(--color-border);
  }

  .service-card {
    padding: 2rem 1.75rem;
    border-right: 1px solid var(--color-border);
    transition: background-color 0.25s ease;
  }

  .service-card:last-child {
    border-right: none;
  }

  .service-card:hover {
    background-color: rgba(201,168,76,0.04);
  }

  .service-num {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: var(--color-primary);
  }

  .service-divider {
    width: 2rem;
    height: 1px;
    background-color: var(--color-border);
    margin: 1rem 0;
    transition: background-color 0.25s ease, width 0.25s ease;
  }

  .service-card:hover .service-divider {
    background-color: var(--color-primary);
    width: 3rem;
  }

  .service-title {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .service-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .service-card:hover .service-link {
    opacity: 1;
  }

  /* ===== ZAŠTO MI ===== */
  .why-section {
    background-color: var(--color-background);
  }

  .why-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .why-title {
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.3;
    margin: 1rem 0 1.25rem;
  }

  .why-body {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .why-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .why-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .why-arrow {
    color: var(--color-primary);
    font-size: 1.25rem;
    line-height: 1;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Vizuelna kolona */
  .why-visual-col {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .why-box-outer {
    position: relative;
    width: 100%;
    max-width: 380px;
  }

  .why-box-inner {
    aspect-ratio: 1;
    border: 1px solid var(--color-border-gold);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    background: rgba(201,168,76,0.02);
  }

  .why-box-brand {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-align: center;
    color: var(--color-primary);
    line-height: 1.5;
    margin: 0;
  }

  .why-box-line {
    display: block;
    width: 2rem;
    height: 1px;
    background-color: var(--color-primary);
    opacity: 0.5;
  }

  .why-box-tagline {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
    text-align: center;
  }

  /* Plutajuće stat kartice */
  .stat-float {
    position: absolute;
    padding: 0.875rem 1.25rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-gold);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stat-float--tl { top: -1.5rem; left: -2rem; }
  .stat-float--br { bottom: -1.5rem; right: -2rem; }

  .stat-float-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-float-tag {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .stat-float-lbl {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ===== HERO PHONE CTA ===== */
  .hero-phone-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-primary);
    color: #000000;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    border: 1px solid var(--color-primary);
    transition: background-color 0.2s, box-shadow 0.2s;
  }

  .hero-phone-cta:hover {
    background-color: var(--color-primary-hover);
    box-shadow: var(--shadow-gold-hover);
  }

  .hero-phone-icon {
    display: flex;
    align-items: center;
  }

  /* ===== KONTAKT KANALI ===== */
  .contact-channels {
    background-color: var(--color-surface);
    padding: 5rem 0;
  }

  .contact-channels-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201,168,76,0.35), transparent);
  }

  .channels-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .channels-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    margin: 0.5rem 0 0;
    letter-spacing: -0.01em;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .channel-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.875rem;
    padding: 2.5rem 1.5rem;
    background-color: var(--color-surface);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .channel-card:not(.channel-card--address):hover {
    background-color: rgba(201,168,76,0.05);
  }

  .channel-card:not(.channel-card--address):hover .channel-icon {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .channel-card:not(.channel-card--address):hover .channel-value {
    color: var(--color-primary);
  }

  .channel-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition: border-color 0.2s, color 0.2s;
  }

  .channel-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .channel-value {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    transition: color 0.2s;
  }

  .channel-card--address {
    cursor: default;
  }

