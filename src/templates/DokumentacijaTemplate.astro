---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const d = tr.docs;

const docFiles = [
  '/dokumenti/Ugovor-o-posredovanju.pdf',
  '/dokumenti/Predugovor-o-kupoprodaji-stana.pdf',
];
const docSizes = ['32 KB', '23 KB'];
---

<BaseLayout title={tr.meta.docs.title} description={tr.meta.docs.description} lang={lang}>

  <section class="page-hero section-sm">
    <div class="container">
      <p class="section-eyebrow">{d.heroEyebrow}</p>
      <h1>{d.heroTitle}</h1>
      <p class="page-hero-sub">{d.heroSub}</p>
    </div>
  </section>

  <section class="section">
    <div class="container docs-layout">
      <div class="doc-group">
        <h2 class="doc-category">{d.categoryContracts}</h2>
        <ul class="doc-list">
          {d.docNames.map((name, i) => (
            <li class="doc-item">
              <div class="doc-info">
                <span class="doc-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="9" y1="15" x2="15" y2="15"/>
                  </svg>
                </span>
                <div>
                  <p class="doc-name">{name}</p>
                  <p class="doc-size">PDF · {docSizes[i]}</p>
                </div>
              </div>
              <a href={docFiles[i]} download class="doc-download" aria-label={`${d.downloadBtn} — ${name}`}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                {d.downloadBtn}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background-color: #000000;
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0.5rem 0 1rem;
  }

  .page-hero-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 40rem;
    margin: 0;
    line-height: 1.7;
  }

  .docs-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 56rem;
  }

  .doc-category {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .doc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .doc-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s ease;
  }

  .doc-item:hover { border-color: var(--color-border-gold); }

  .doc-info {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .doc-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border-gold);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .doc-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
    margin: 0 0 0.2rem;
  }

  .doc-size {
    font-size: 0.8rem;
    color: var(--color-text-dim);
    margin: 0;
    letter-spacing: 0.03em;
  }

  .doc-download {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1.125rem;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    flex-shrink: 0;
    transition: background-color 0.2s, color 0.2s;
  }

  .doc-download:hover {
    background-color: var(--color-primary);
    color: #000000;
  }

  @media (max-width: 480px) {
    .doc-item { flex-direction: column; align-items: flex-start; }
    .doc-download { align-self: stretch; justify-content: center; }
  }
</style>
