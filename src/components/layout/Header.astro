---
import { site } from '../../data/site';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <div class="container header-inner">

    <!-- Logo -->
    <a href="/" class="logo" aria-label={`${site.name} – početna`}>
      <img
        src="/logo.jpg"
        alt="Despot Nekretnine logo"
        class="logo-mark"
        width="44"
        height="44"
      />

      <span class="logo-text">
        <span class="logo-brand">DESPOT</span>
        <span class="logo-sub">nekretnine</span>
      </span>
    </a>

    <!-- Desktop navigacija -->
    <nav class="nav-desktop" aria-label="Glavna navigacija">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- CTA -->
    <a href="/kontakt" class="btn-header-cta">
      Kontaktirajte nas
    </a>

    <!-- Hamburger -->
    <button
      id="menu-toggle"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Otvori meni"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobilni meni -->
  <nav id="mobile-menu" class="nav-mobile" aria-label="Mobilna navigacija" aria-hidden="true">
    <ul>
      {site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-mobile-link', { 'nav-mobile-link--active': isActive(item.href) }]}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/kontakt" class="nav-mobile-cta">Kontaktirajte nas</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu   = document.getElementById('mobile-menu')!;
  const header = document.getElementById('site-header')!;

  toggle.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu.setAttribute('aria-hidden', String(isOpen));
    toggle.classList.toggle('is-open', !isOpen);
    menu.classList.toggle('is-open', !isOpen);
  });

  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) {
      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      toggle.classList.remove('is-open');
      menu.classList.remove('is-open');
    }
  });

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-background);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 24px rgba(0,0,0,0.6);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 5rem;
  }

  /* === LOGO === */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 50%;
    filter: drop-shadow(0 0 8px rgba(201, 168, 76, 0.3));
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-brand {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--color-primary);
  }

  .logo-sub {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: lowercase;
    color: var(--color-text-muted);
  }

  /* === DESKTOP NAV === */
  .nav-desktop {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-desktop ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.125rem;
  }

  .nav-link {
    display: block;
    padding: 0.4rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-link--active {
    color: var(--color-primary);
  }

  /* === CTA === */
  .btn-header-cta {
    flex-shrink: 0;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .btn-header-cta:hover {
    background-color: var(--color-primary);
    color: #000000;
  }

  /* === HAMBURGER === */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.375rem;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
  }

  .hamburger-bar {
    display: block;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-primary);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle.is-open .hamburger-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .menu-toggle.is-open .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.is-open .hamburger-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* === MOBILNI MENI === */
  .nav-mobile {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .nav-mobile.is-open {
    max-height: 30rem;
  }

  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
  }

  .nav-mobile-link {
    display: block;
    padding: 0.75rem 1.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-mobile-link:hover,
  .nav-mobile-link--active {
    color: var(--color-primary);
  }

  .nav-mobile-cta {
    display: block;
    margin: 0.75rem 1.5rem;
    padding: 0.75rem 1.25rem;
    text-align: center;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  /* === RESPONSIVE === */
  @media (max-width: 900px) {
    .nav-desktop, .btn-header-cta { display: none; }
    .menu-toggle { display: flex; }
    .nav-mobile  { display: block; }
  }
</style>
