---
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="container footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label={site.name}>
          <img src="/logo.jpg" alt="Despot Nekretnine logo" width="38" height="38" class="footer-logo-img" />
          <span class="footer-logo-text">
            <span class="footer-logo-brand">DESPOT</span>
            <span class="footer-logo-sub">nekretnine</span>
          </span>
        </a>
        <p class="footer-desc">{site.tagline}</p>

        <div class="footer-social">
          {site.social.facebook && (
            <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
              </svg>
            </a>
          )}
          {site.social.instagram && (
            <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Navigacija -->
      <div class="footer-col">
        <h3 class="footer-heading">Navigacija</h3>
        <ul>
          {site.nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Usluge -->
      <div class="footer-col">
        <h3 class="footer-heading">Usluge</h3>
        <ul>
          <li><a href="/usluge">Kupovina nekretnina</a></li>
          <li><a href="/usluge">Prodaja nekretnina</a></li>
          <li><a href="/usluge">Iznajmljivanje</a></li>
          <li><a href="/usluge">Pravno savetovanje</a></li>
        </ul>
      </div>

      <!-- Kontakt -->
      <div class="footer-col">
        <h3 class="footer-heading">Kontakt</h3>
        <ul class="footer-contact">
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.82a19.79 19.79 0 01-3.07-8.63A2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a>
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{site.contact.address}</span>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Gold separator -->
  <div class="footer-separator">
    <div class="container">
      <div class="footer-separator-line"></div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {year} {site.name}. Sva prava zadržana.</p>
      <nav aria-label="Pravne veze">
        <a href="/dokumentacija">Pravna dokumentacija</a>
        <a href="/politika-privatnosti">Politika privatnosti</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .footer-top {
    padding: 4rem 0 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1.2fr;
    gap: 3rem;
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    border-radius: 50%;
  }

  .footer-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .footer-logo-brand {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--color-primary);
  }

  .footer-logo-sub {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
  }

  .footer-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .footer-social {
    display: flex;
    gap: 0.625rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .footer-social a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Kolone */
  .footer-heading {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-col ul a,
  .footer-col ul span {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-col ul a:hover {
    color: var(--color-primary);
  }

  /* Kontakt */
  .footer-contact {
    gap: 0.875rem !important;
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .footer-contact li svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color-primary);
  }

  /* Separator */
  .footer-separator {
    padding: 0;
  }

  .footer-separator-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    opacity: 0.35;
  }

  /* Bottom */
  .footer-bottom {
    padding: 1.25rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    margin: 0;
  }

  .footer-bottom nav {
    display: flex;
    gap: 1.5rem;
  }

  .footer-bottom nav a {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    text-decoration: none;
  }

  .footer-bottom nav a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
