---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost' | 'gold-fill';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}><slot /></a>
  ) : (
    <button type={type} class={classes} {...rest}><slot /></button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease,
                border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .btn--sm  { padding: 0.4rem 1rem;   font-size: 0.7rem; }
  .btn--md  { padding: 0.65rem 1.5rem; font-size: 0.8rem; }
  .btn--lg  { padding: 0.875rem 2rem;  font-size: 0.875rem; }

  /* Zlatna ispuna — za primarne CTA */
  .btn--gold-fill {
    background-color: var(--color-primary);
    color: #000000;
    border-color: var(--color-primary);
  }
  .btn--gold-fill:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    box-shadow: var(--shadow-gold-hover);
  }

  /* Outline zlatni — sekundarni CTA */
  .btn--primary, .btn--outline {
    background-color: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .btn--primary:hover, .btn--outline:hover {
    background-color: var(--color-primary);
    color: #000000;
    box-shadow: var(--shadow-gold);
  }

  /* Ghost */
  .btn--ghost {
    background-color: transparent;
    color: var(--color-text-muted);
    border-color: transparent;
  }
  .btn--ghost:hover {
    color: var(--color-primary);
  }
</style>
